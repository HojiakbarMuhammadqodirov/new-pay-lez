{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    /* `vite/client` because the suite imports `src/` the way the browser does —
       transitively that reaches `import.meta.env` and asset imports — and
       `node` because it is a command-line program that ends in `process.exit`. */
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode, matching tsconfig.app.json: `npm run verify` runs under
       vite-node, so the suite resolves `../src/...` exactly as the app does —
       extensionless, with JSON and `.tsx` on the path. Type-checking it under
       the node project's `nodenext` resolution would reject every one of those
       imports for a reason the runtime does not have. */
    "moduleResolution": "bundler",
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts"]
}

# ─────────────────────────────────────────────────────────────────────────────
# /etc/paylez/paylez.env — the server's environment file.
#
# Copy this to the host, fill in the blanks, and point systemd at it:
#
#   sudo install -d -m 750 -o paylez -g paylez /etc/paylez
#   sudo install -m 640 -o root -g paylez paylez.env.example /etc/paylez/paylez.env
#   sudo -e /etc/paylez/paylez.env          # fill in the secrets
#
#   # /etc/systemd/system/paylez.service
#   [Service]
#   EnvironmentFile=/etc/paylez/paylez.env
#   ExecStart=/usr/bin/node --experimental-strip-types server/index.ts
#
# Mode 640 root:paylez, because every secret below is readable by whoever can
# read this file and spendable by whoever reads it.
#
# NOTHING HERE MAY EVER TAKE A `VITE_` PREFIX. Vite bakes those into the
# browser bundle. The front end's own (public) variables are `.env.example` in
# the repo root; the split between the two files is the whole security model.
# ─────────────────────────────────────────────────────────────────────────────

# ── where it listens ─────────────────────────────────────────────────────────
# Bind to loopback and put nginx/Caddy in front for TLS. 0.0.0.0 exposes the
# API directly, without a certificate.
HOST=127.0.0.1
PORT=8787

# Which origins the browser may call it from. The deployed site's domain —
# comma-separated, scheme included, no trailing slash. A missing entry here is
# the usual cause of "it works locally and the deployed site sees nothing".
PAYLEZ_ORIGINS=https://paylez.example,https://www.paylez.example

# Where SQLite lives. The directory must be writable by the service user.
PAYLEZ_DB=/var/lib/paylez/paylez.db

# ── secrets ──────────────────────────────────────────────────────────────────
# Signs QR payloads and sessions. The server warns loudly and uses a dev
# fallback when this is unset, which is fine on a laptop and not on a host.
#   openssl rand -hex 32
PAYLEZ_SECRET=

# 16-byte hex master key for NTAG 424 DNA taps. Leave unset until there is
# hardware to tap.
#   openssl rand -hex 16
PAYLEZ_NFC_KEY=

# ── the AI assistant ─────────────────────────────────────────────────────────
# THIS IS WHERE THE CLAUDE KEY GOES. Nowhere else — not in the repo, not in
# `.env.local`, and never with a `VITE_` prefix.
#
# Get one at console.anthropic.com → API keys. It starts `sk-ant-`.
ANTHROPIC_API_KEY=

# Two switches rather than one, because they answer different questions: the
# key says a model *can* be called, this says this deployment *wants* one. A
# staging box that inherits a production env file does not start spending.
# `off` (or unset) leaves the assistant composing its answers deterministically,
# which is a supported state and not a degraded one.
PAYLEZ_LLM=live

# Claude Haiku 4.5. The model's whole job is to reword one already-correct,
# already-grounded sentence — the facts, the figures and the action are decided
# by `domain/assistant.ts` before it is called and re-checked after it answers
# (`ports/llm.ts`, `onlyKnownNumbers`). That is a small job on the request path
# of a chat panel, so it takes the cheapest and fastest model in the family.
# Change it here to try another without a deploy; `claude-sonnet-5` is the one
# worth trying if the prose in Polish, Uzbek, Russian or Ukrainian reads thin.
PAYLEZ_LLM_MODEL=claude-haiku-4-5

# Ceilings on one rewrite. Past either, the deterministic sentence is sent, so
# the worst case is "no worse than off".
PAYLEZ_LLM_MAX_TOKENS=400
PAYLEZ_LLM_TIMEOUT_MS=3000

# ── Google sign-in ───────────────────────────────────────────────────────────
# The client id must be the SAME value as the front end's VITE_GOOGLE_CLIENT_ID
# — the server checks it as the token's audience, so a mismatch rejects every
# sign-in with "could not be verified" and looks like a broken button.
PAYLEZ_GOOGLE_CLIENT_ID=
PAYLEZ_GOOGLE_CLIENT_SECRET=

# ── the one admin ────────────────────────────────────────────────────────────
# Provisioned at boot. Both unset means `/v1/admin/*` is unreachable, which is
# the correct state for a host that does not need the console.
PAYLEZ_ADMIN_EMAIL=
PAYLEZ_ADMIN_PASSWORD=

# ── adapters ─────────────────────────────────────────────────────────────────
# `live` refuses to boot without a real implementation behind it, which is
# deliberate: a billing adapter that silently no-ops in production is worse than
# one that will not start.
PAYLEZ_BILLING=local
PAYLEZ_PUSH=local
